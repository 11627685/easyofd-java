<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.easyofd</groupId>
    <artifactId>easyofd-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>easyofd-demo</name>
    <description>OFD 板式文件（GB/T 33190-2016）easyofd 示例工程</description>
    <url>https://github.com/11627685/easyofd-java</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>火柴盒</name>
            <email>11627685@qq.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/11627685/easyofd-java.git</connection>
        <developerConnection>scm:git:git@github.com:11627685/easyofd-java.git</developerConnection>
        <url>https://github.com/11627685/easyofd-java</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <easyofd.version>2.0.0</easyofd.version>
        <junit.version>4.13.2</junit.version>
        <bc.version>1.70</bc.version>
    </properties>

    <dependencies>
        <!-- easyofd 核心库，从 Maven Central 获取 -->
        <dependency>
            <groupId>cn.easyofd</groupId>
            <artifactId>easyofd</artifactId>
            <version>${easyofd.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 示例中的证书生成与签章需要 BouncyCastle -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>${bc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk15on</artifactId>
            <version>${bc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
